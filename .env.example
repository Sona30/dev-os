# =====================================================================
# TestReady — environment variables
# Copy to .env.local (local) and set the same values in Netlify
# (Site settings > Environment variables). Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are bundled into the browser; every
# other variable is SERVER ONLY.
# =====================================================================

# App
NEXT_PUBLIC_SITE_URL=                 # Public base URL, e.g. https://testready.netlify.app (http://localhost:3000 locally)
NODE_ENV=                             # development | production (set by Next.js / Netlify)
APP_ENV=                              # local | staging | production — used in logs and cost alerts
LOG_LEVEL=                            # debug | info | warn | error (default info)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=             # Supabase project URL — Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Supabase anon/public key — Settings > API
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY — Supabase service role key — Settings > API (bypasses RLS; never expose to client)
SUPABASE_STORAGE_UPLOADS_BUCKET=      # Bucket name for photos/report pages — must be "uploads" (created by supabase-schema.sql)
SUPABASE_STORAGE_WORKSHEETS_BUCKET=   # Bucket name for generated PDFs — must be "worksheets" (created by supabase-schema.sql)

# Azure AI Foundry (Agent Service)
FOUNDRY_ENDPOINT=                     # SERVER ONLY — Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project> — Foundry portal > project overview
FOUNDRY_AGENT_NAME=                   # SERVER ONLY — exact name of the agent in Foundry portal > Agents (requests use an agent_reference to it; its instructions must be prompts/v1.0/system.md)
FOUNDRY_MODEL_DEPLOYMENT=             # SERVER ONLY — optional; only labels usage rows (the agent's own model is set in Foundry)
FOUNDRY_GRADER_DEPLOYMENT=            # SERVER ONLY — optional; labels grading usage rows
FOUNDRY_VECTOR_STORE_ID=              # SERVER ONLY — id of the "testready-kb" vector store (printed by `npm run kb:sync`)
FOUNDRY_API_TIMEOUT_MS=               # SERVER ONLY — per-call timeout in ms (default 120000)
FOUNDRY_PRICE_INPUT_PER_1M_USD=       # SERVER ONLY — input token price per 1M tokens for cost estimates — Azure pricing page
FOUNDRY_PRICE_OUTPUT_PER_1M_USD=      # SERVER ONLY — output token price per 1M tokens for cost estimates
FOUNDRY_CODE_INTERPRETER_SESSION_USD= # SERVER ONLY — flat estimate added per Code Interpreter session (default 0.03)

# Azure identity (service principal used by @azure/identity)
AZURE_TENANT_ID=                      # SERVER ONLY — Entra ID tenant id — Azure portal > Entra ID > Overview
AZURE_CLIENT_ID=                      # SERVER ONLY — service principal (app registration) client id
AZURE_CLIENT_SECRET=                  # SERVER ONLY — service principal client secret (needs "Azure AI User" role on the Foundry project)

# Background jobs (Netlify)
JOB_SIGNING_SECRET=                   # SERVER ONLY — random 32+ byte hex string; HMAC key for POST /.netlify/functions/run-job-background (generate: openssl rand -hex 32)
JOB_EXECUTION_MODE=                   # SERVER ONLY — netlify | inline. "inline" runs jobs inside the Next.js process (local dev default); "netlify" calls the background function (production default)
JOB_MAX_RUNTIME_MINUTES=              # SERVER ONLY — jobs running longer than this are failed by reap-stale-jobs (default 10)
JOB_MAX_CONCURRENT_PER_USER=          # SERVER ONLY — default 2
CRON_SECRET=                          # SERVER ONLY — shared secret for scheduled functions that are also exposed over HTTP for manual runs (openssl rand -hex 32)

# Limits and thresholds
DISABLE_SIGNED_URLS=                  # SERVER ONLY — true disables issuing signed image/PDF URLs (incident containment switch; default false)
SITE_NOTICE_TEXT=                     # Optional in-app banner text shown to all users during incidents (empty = no banner)
EXTRACTION_CONFIDENCE_THRESHOLD=      # SERVER ONLY — items below this go to the parent review queue (default 0.85)
MAX_UPLOAD_BYTES=                     # SERVER ONLY — per-image limit (default 10485760)
UPLOAD_RETENTION_DAYS=                # SERVER ONLY — images deleted after this many days (default 30)
SIGNED_URL_TTL_SECONDS=               # SERVER ONLY — lifetime of signed read URLs for PDFs and crops (default 900)
DAILY_CYCLE_CAP_DEFAULT=              # SERVER ONLY — default cycles per user per day (default 3)
RATE_LIMIT_ENABLED=                   # SERVER ONLY — true | false (default true; false is honoured only outside production, for local tests)
DISABLE_FREE_LIMIT=                   # SERVER ONLY — true | false — testing only: lets a free account keep creating worksheets after its one free cycle (the daily cap still applies). Leave unset in production.

# Cost monitoring and alerts
MONTHLY_BUDGET_USD=                   # SERVER ONLY — monthly AI spend budget; alert at 80%
COST_PER_CYCLE_ALERT_USD=             # SERVER ONLY — rolling 7-day average cost per cycle that triggers an alert (default 0.35)
OVERRIDE_RATE_ALERT=                  # SERVER ONLY — parent override rate (0-1) over 7 days that triggers an alert (default 0.10)
ALERT_WEBHOOK_URL=                    # SERVER ONLY — Slack/Teams incoming webhook for cost, override-rate and job-failure alerts
ALERT_EMAIL_TO=                       # SERVER ONLY — fallback alert recipient for the on-call owner

# Support
NEXT_PUBLIC_SUPPORT_EMAIL=            # Address shown on the privacy and terms pages for questions and account deletion requests (leave empty to hide the line)

# Email (transactional: auth emails use Supabase; reminders are Phase 2)
EMAIL_PROVIDER_API_KEY=               # SERVER ONLY — provider key (Resend) for season reminders and incident notices (Phase 2)
EMAIL_FROM=                           # Verified sender address, e.g. TestReady <hello@yourdomain.com>

# Stripe (Phase 2 — leave empty in MVP; paywall stub does not call Stripe)
STRIPE_SECRET_KEY=                    # SERVER ONLY — Stripe secret key — Dashboard > Developers > API keys
STRIPE_WEBHOOK_SECRET=                # SERVER ONLY — signing secret for /api/stripe/webhook — Dashboard > Developers > Webhooks
STRIPE_PRICE_SEASON_PASS=             # Stripe price id for the $29 / 12-week Season Pass
STRIPE_PRICE_FAMILY_MONTHLY=          # Stripe price id for Family $9.99 / month
STRIPE_PRICE_FAMILY_ANNUAL=           # Stripe price id for Family $79 / year
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # Stripe publishable key (only if Stripe.js elements are used; Checkout redirect does not need it)

# Product analytics (optional)
NEXT_PUBLIC_ANALYTICS_KEY=            # Public key for the chosen product analytics tool; leave empty to disable (events still go to usage_events)

# Testing
E2E_BASE_URL=                         # Base URL Playwright runs against (default http://localhost:3000)
E2E_USER_EMAIL=                       # Test-only account email in the staging Supabase project
E2E_USER_PASSWORD=                    # Test-only account password (staging only; never a real user's password)
FOUNDRY_MOCK=                         # true | false — when true, the Foundry client returns fixtures from tests/fixtures/foundry (unit/integration/E2E)
EVAL_REPORT_DIR=                      # Output directory for AI evaluation reports (default tests/eval/reports)
# Folder holding the labelled evaluation data (reports/, sheets/, adversarial/); see nextjs-app/tests/eval/DATASET_CARD.md
EVAL_DATA_DIR=
# Skills catalogue JSON used by the generation eval (defaults to tests/fixtures/skills_catalog.dev.json)
EVAL_CATALOG=
