{
  "name": "testready",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prompts:build && npm run kb:version && npm run build:functions && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:functions": "node scripts/build-functions.mjs",
    "prompts:build": "node scripts/prompts-build.mjs",
    "kb:version": "node scripts/kb-version.mjs",
    "predev": "npm run prompts:build && npm run kb:version",
    "kb:sync": "node --env-file=.env.local scripts/kb-sync.mjs",
    "agent:sync": "node --env-file=.env.local scripts/agent-sync.mjs",
    "seed:catalog": "node --env-file=.env.local scripts/seed-catalog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "RUN_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "eval": "vite-node --config vitest.eval.config.ts tests/eval/run.ts --",
    "eval:gate": "vite-node --config vitest.eval.config.ts tests/eval/gate.ts --"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@hookform/resolvers": "^3.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.56.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.441.0",
    "next": "^14.2.35",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "pino": "^9.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.23.1",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.10",
    "typescript": "^5",
    "vite-node": "^2.1.1",
    "vitest": "^2.1.1"
  }
}
